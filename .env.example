# ==============================================================================
# SARIGAMA Environment Configuration
# Copy this file to .env and configure for your environment.
# Never commit .env with real secrets to version control.
# ==============================================================================

# ==================== Environment & Operational Mode ====================
# Environment mode: 'development' or 'production'
# In 'production', authentication fails closed if SARIGAMA_API_KEY is not set.
SARIGAMA_ENV=development

# API key for authentication on protected endpoints (/v1/*)
# In production, this MUST be configured with a high-entropy secret.
# In development, leaving this empty allows unauthenticated access.
SARIGAMA_API_KEY=
# Legacy alias for backward compatibility:
# ACESTEP_API_KEY=

# Maximum audio upload size in Megabytes (default: 50MB)
SARIGAMA_MAX_UPLOAD_SIZE_MB=50

# CORS Allowed Origins (comma-separated list of origins)
# In development, defaults to localhost, 127.0.0.1, and null.
# In production, default is empty (disallows external origins) unless configured.
# SARIGAMA_CORS_ORIGINS=https://app.sarigama.ai,https://studio.sarigama.ai

# ==================== Queue & Resource Management ====================
# Maximum pending jobs allowed in memory queue (default: 200)
# Returns HTTP 429 when queue reaches capacity.
ACESTEP_QUEUE_MAXSIZE=200

# Number of worker threads for job execution (default: 1 for single GPU)
ACESTEP_QUEUE_WORKERS=1

# Estimated average job duration in seconds for progress calculation
ACESTEP_AVG_JOB_SECONDS=5.0
ACESTEP_AVG_WINDOW=50

# ==================== Model Settings ====================
# Default DiT model path/name (e.g., acestep-v15-turbo, acestep-v15-base)
ACESTEP_CONFIG_PATH=acestep-v15-turbo

# LM model path (used when LLM is enabled)
# Available: acestep-5Hz-lm-0.6B, acestep-5Hz-lm-1.7B, acestep-5Hz-lm-4B
ACESTEP_LM_MODEL_PATH=acestep-5Hz-lm-1.7B

# Device selection: auto, cuda, mps, cpu, xpu
ACESTEP_DEVICE=auto

# LM backend: vllm (faster), pt (PyTorch native), or mlx (Apple Silicon)
ACESTEP_LM_BACKEND=auto

# ==================== LLM Initialization ====================
# Controls whether to initialize the Language Model (LLM/5Hz LM)
# Values:
#   auto (or empty)    = Use GPU auto-detection result (recommended)
#   true/1/yes         = Force enable LLM after GPU detection (may cause OOM)
#   false/0/no         = Force disable LLM (pure DiT mode, faster)
ACESTEP_INIT_LLM=auto

# ==================== Model Storage & Downloads ====================
# Shared checkpoints directory (useful when sharing model weights)
# ACESTEP_CHECKPOINTS_DIR=~/sarigama-models

# Preferred download source: auto, huggingface, modelscope
ACESTEP_DOWNLOAD_SOURCE=auto

# ==================== Gradio UI Settings ====================
# Web UI port (default: 7860)
PORT=7860

# Bind host (default: 127.0.0.1 for local only; use 0.0.0.0 only behind a reverse proxy)
SERVER_NAME=127.0.0.1

# UI language: en, zh, ja
LANGUAGE=en

# Default generation batch size (1 to 8, GPU memory permitting)
ACESTEP_BATCH_SIZE=2

# Startup model loading: lazy-load on first request (true) or eager load (false)
ACESTEP_NO_INIT=true